        <note from="lit-localize">Error when importing a hash flow file</note>
        <target>கோப்பில் ஹாஷ் ஓட்டம் இல்லை: முனைகளின் பட்டியலுடன் ஒரு பொருள் எதிர்பார்க்கப்பட்டது.</target>
      </trans-unit>
      <trans-unit id="s09c392ee49009358">
        <source>The hash flow has no nodes.</source>
        <note from="lit-localize">Error when importing a hash flow file</note>
        <target>ஹாஷ் ஓட்டத்தில் முனைகள் இல்லை.</target>
      </trans-unit>
      <trans-unit id="s0547b3b890aa9ad9">
        <source>Every node needs a unique id and one of the kinds Key, Salt, HashFunction or HashValue.</source>
        <note from="lit-localize">Error when importing a hash flow file</note>
        <target>ஒவ்வொரு முனைக்கும் தனித்துவமான ID மற்றும் Key, Salt, HashFunction அல்லது HashValue வகைகளில் ஒன்று தேவை.</target>
      </trans-unit>
      <trans-unit id="sfd77270c3f54f664">
        <source>Output</source>
        <note from="lit-localize">Label of a socket that starts a wire</note>
        <target>வெளியீடு</target>
      </trans-unit>
      <trans-unit id="sdb1595f5c742dfbb">
        <source>Input</source>
        <note from="lit-localize">Label of a socket that takes a wire</note>
        <target>உள்ளீடு</target>
      </trans-unit>
      <trans-unit id="s8ea7045d123f1069">
        <source>Generate a new salt</source>
        <note from="lit-localize">Label of the button that replaces the salt with a new random one</note>
        <target>புதிய உப்பை உருவாக்கு</target>
      </trans-unit>
      <trans-unit id="sb4257e5602624b51">
        <source>Rename node</source>
        <note from="lit-localize">Label of the node title, which a click or Enter turns into a text field</note>
        <target>முனையின் பெயரை மாற்று</target>
      </trans-unit>
      <trans-unit id="sb7d5b32d98b626df">
        <source>Node title</source>
        <note from="lit-localize">Label of the text field for renaming a node</note>
        <target>முனைத் தலைப்பு</target>
      </trans-unit>
