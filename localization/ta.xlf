      <trans-unit id="hc60fe849d5871ed0">
        <source>Key + <x id="0" equiv-text="&lt;b&gt;" />Salt<x id="1" equiv-text="&lt;/b&gt;" />
        </source>
        <note from="lit-localize">Label of the field showing the key with the salt appended</note>
        <target>விசை + <x id="0" equiv-text="&lt;b&gt;" />சால்ட்<x id="1" equiv-text="&lt;/b&gt;" />
        </target>
      </trans-unit>
      <trans-unit id="s340c5424c1068661">
        <source>Salt</source>
        <note from="lit-localize">Name of the node appending a salt to the key</note>
        <target>சால்ட்</target>
      </trans-unit>
      <trans-unit id="s506b6a19d12f414c">
        <source>Key</source>
        <note from="lit-localize">Name of the node holding the text that gets hashed</note>
        <target>விசை</target>
      </trans-unit>
      <trans-unit id="s082194e632f41463">
