      <trans-unit id="s658e6a008311409f">
        <source>Drag and drop the nodes into the editor</source>
        <target>நோடுகளைத் திருத்தியில் இழுத்துவிட்டு விடுங்கள்</target>
      </trans-unit>
      <trans-unit id="s80a693fdbbc735b3">
