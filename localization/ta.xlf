        <note from="lit-localize">Name of the node selecting the hash algorithm</note>
        <target>ஹாஷ் செயல்பாடு</target>
      </trans-unit>
      <trans-unit id="s8617fc8fa9c02980">
        <source>Hash Value</source>
        <note from="lit-localize">Name of the node showing the hashing result</note>
        <target>ஹாஷ் மதிப்பு</target>
      </trans-unit>
      <trans-unit id="s5f343a43e7ea9f91">
        <source>Error</source>
        <note from="lit-localize">Shown instead of a hash value when hashing fails</note>
        <target>பிழை</target>
      </trans-unit>
      <trans-unit id="sc26501e3ade7da3c">
        <source>Tools</source>
        <note from="lit-localize">Title of the drawer listing the draggable nodes</note>
        <target>கருவிகள்</target>
      </trans-unit>
      <trans-unit id="sbc7afdec03639488">
        <source>Delete selection</source>
        <note from="lit-localize">Action that removes the selected nodes and connections</note>
        <target>தேர்வை நீக்கு</target>
      </trans-unit>
      <trans-unit id="sb8c878135ee917b1">
        <source>The file is not valid JSON.</source>
        <note from="lit-localize">Error when importing a hash flow file</note>
        <target>கோப்பு சரியான JSON அல்ல.</target>
      </trans-unit>
      <trans-unit id="s41290bf7059fcf83">
